# Client Firebase configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Firebase configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI providers — server only, never expose GEMINI_API_KEY to the browser
GEMINI_API_KEY=
GEMINI_STORY_MODEL=gemini-2.5-flash
GEMINI_STORY_TIMEOUT_MS=90000
GEMINI_STORY_MAX_ATTEMPTS=2

# Image generation: always produces a story edition and a text-free coloring edition
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_TIMEOUT_MS=120000
GEMINI_IMAGE_MAX_ATTEMPTS=2
IMAGE_JOB_CONCURRENCY=1
IMAGE_RATE_LIMIT_WINDOW_MS=1800000
IMAGE_RATE_LIMIT_MAX=2
IMAGE_REGEN_RATE_LIMIT_WINDOW_MS=1800000
IMAGE_REGEN_RATE_LIMIT_MAX=12
GENERATED_ASSET_DIR=./generated-assets
GENERATED_ASSET_PUBLIC_BASE_URL=/generated-assets

# Story API cost protection
STORY_RATE_LIMIT_WINDOW_MS=600000
STORY_RATE_LIMIT_MAX=6

# Google Drive server authentication.
# Share the ColorVerse root folder with GOOGLE_DRIVE_CLIENT_EMAIL before enabling production storage.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_TOKEN_URL=https://oauth2.googleapis.com/token

# Approved ColorVerse Drive structure
GOOGLE_DRIVE_ROOT_FOLDER_ID=1YuDr40M0bUeIiscayhIfPLWvuJ8uYdlO
