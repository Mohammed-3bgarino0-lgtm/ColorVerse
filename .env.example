# Client Firebase configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Firebase configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI story provider — server only, never expose GEMINI_API_KEY to the browser
GEMINI_API_KEY=
GEMINI_STORY_MODEL=gemini-2.5-flash
GEMINI_STORY_TIMEOUT_MS=90000
GEMINI_STORY_MAX_ATTEMPTS=2

# Story API cost protection
STORY_RATE_LIMIT_WINDOW_MS=600000
STORY_RATE_LIMIT_MAX=6

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
PORT=3000
NODE_ENV=development
