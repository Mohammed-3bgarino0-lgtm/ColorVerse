{
  "name": "colorverse-kids-book-generator",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Bilingual Arabic and English AI-powered kids coloring book generator.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:full": "tsc --noEmit -p tsconfig.json",
    "typecheck:stories": "tsc --noEmit -p tsconfig.story-engine.json",
    "validate:stories": "node scripts/validate-story-catalog.mjs",
    "validate:story-review": "node scripts/validate-parent-review-runtime.mjs",
    "validate:book-print": "node scripts/validate-book-print-review.mjs",
    "validate:story-images": "node scripts/validate-story-image-runtime.mjs",
    "validate:image-review": "node scripts/validate-image-review-runtime.mjs",
    "validate:drive-storage": "node scripts/validate-google-drive-storage.mjs",
    "validate:system-readiness": "node scripts/validate-system-readiness.mjs",
    "test:story-ai": "tsx scripts/test-story-ai-contract.ts",
    "test:story-images": "tsx scripts/test-story-image-editions.ts",
    "test:image-regeneration": "tsx scripts/test-story-image-regeneration.ts",
    "test:book-lifecycle": "tsx scripts/test-book-lifecycle.ts",
    "quality:stories": "npm run validate:stories && npm run validate:story-review && npm run validate:book-print && npm run validate:story-images && npm run validate:image-review && npm run validate:drive-storage && npm run validate:system-readiness && npm run typecheck:stories && npm run test:story-ai && npm run test:story-images && npm run test:image-regeneration && npm run test:book-lifecycle"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "firebase": "latest",
    "firebase-admin": "latest",
    "html2canvas": "latest",
    "jspdf": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "latest",
    "tsx": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  }
}
